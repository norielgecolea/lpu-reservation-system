POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lpu_reservation
POSTGRES_PORT=5432

# Passed into the Tomcat container. JWT_SECRET must be at least 32 random characters.
# Rotating JWT_SECRET signs everyone out once.
MAIL_PASSWORD=
JWT_SECRET=
# Used only when the database has no SUPERADMIN yet.
SUPERADMIN_INITIAL_PASSWORD=

# Maven Tomcat deploy profiles (tomcat1 / tomcat2). Not read by Docker.
# tomcat.manager.password=

CLOUDFLARE_TUNNEL_TOKEN=

TOMCAT_USERNAME=
TOMCAT_PASSWORD=
TOMCAT_PORT=

# Frontend / Angular
# Dev proxy target (proxy.conf.js) and Docker angular → Tomcat.
# Docker Compose: use http://reservation-tomcat:8080
# Host `ng serve`: use http://localhost:8080
BACKEND_URL=http://reservation-tomcat:8080
# SSR Node server only (src/server.ts / serve:ssr).
# Do NOT use the name PORT — Angular CLI will steal it and break ng serve on 4200.
SSR_PORT=4000
