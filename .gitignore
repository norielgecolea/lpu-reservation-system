# OS
.DS_Store
Thumbs.db
Desktop.ini

# Env / secrets (keep .env.example tracked)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Docker / local runtime data (DB, nginx, tunnel, etc.)
data/*
!data/tomcat/
!data/tomcat/**

# Tomcat logs (keep folder, skip log files)
data/tomcat/logs/**
!data/tomcat/logs/.gitkeep

# IDE / Eclipse
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.metadata/
!backend/.metadata/
!backend/.metadata/**
# Machine-local Eclipse lock files (don't share across clones)
backend/.metadata/.lock
backend/.metadata/.lock_info
*.swp
*~

# VS Code (local)
.vscode/

# Java / Maven
**/target/
**/bin/
*.class
*.jar
*.war
!data/tomcat/**/*.war
*.ear
hs_err_pid*
replay_pid*

# Node / Angular
**/node_modules/
**/dist/
**/.angular/
**/coverage/
.npm/
*.tsbuildinfo

# Frontend misc
frontend/frontend/.sass-cache/
frontend/frontend/tmp/
