server {
    listen ${NGINX_PORT};
    server_name ${SERVER_NAME};

    # Backend API + WebSocket (STOMP/SockJS) → Tomcat
    location /lpu-reservation-system/ {
        proxy_pass http://${TOMCAT_HOST}:${TOMCAT_PORT};

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vehicle images and other static uploads (Tomcat webapps/uploads)
    location /uploads/ {
        proxy_pass http://${TOMCAT_HOST}:${TOMCAT_PORT};

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Angular production build (static files)
    # SSR-capable builds emit index.csr.html for client-side hosting.
    root /usr/share/nginx/html;
    index index.csr.html index.html;

    location / {
        try_files $uri $uri/ /index.csr.html;
    }
}